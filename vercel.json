{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/mcp",
      "destination": "/api"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sse",
      "destination": "/api"
    },
    {
      "source": "/sse/(.*)",
      "destination": "/api"
    },
    {
      "source": "/messages",
      "destination": "/api"
    },
    {
      "source": "/messages/(.*)",
      "destination": "/api"
    },
    {
      "source": "/swagger",
      "destination": "/api"
    },
    {
      "source": "/swagger/(.*)",
      "destination": "/api"
    },
    {
      "source": "/openapi.json",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
